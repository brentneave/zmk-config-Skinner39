#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <280>;
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    hold-trigger-on-release;
};

&mt {
    tapping-term-ms = <280>;
    flavor = "balanced";
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    hold-trigger-on-release;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "COLEMAK";
            bindings = <
&kp Q           &kp W           &kp F               &kp P               &kp G                                       &kp J           &kp L           &kp U           &kp Y           &kp SINGLE_QUOTE
&mt LSHIFT A    &mt LCTRL R     &mt LALT S          &mt LGUI T          &kp D                                       &kp H           &mt RGUI N      &mt RALT E      &mt RCTRL I     &mt RSHIFT O
&kp Z           &kp X           &kp C               &kp V               &kp B                                       &kp K           &kp M           &kp COMMA       &kp DOT         &kp SLASH
&mo 1           &mo 2           &mo 3               &mkp MB2            &mkp MB1      &mo 5           &lt 5 ENTER   &lt 4 SPACE                                                     &trans
            >;
        };

        bluetooth_layer {
            label = "BT";
            bindings = <
&bt BT_CLR      &trans          &trans              &trans              &bootloader                                 &trans          &trans          &trans          &trans          &trans
&trans          &trans          &trans              &trans              &trans                                      &trans          &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3
&trans          &trans          &trans              &trans              &trans                                      &trans          &bt BT_PRV      &trans          &bt BT_NXT      &trans
&trans          &trans          &trans              &trans              &trans        &trans          &trans        &trans                                                          &trans
            >;
        };

        fn_layer {
            label = "FN";
            bindings = <
&trans          &trans          &trans              &trans              &trans                                      &trans          &kp F7          &kp F8          &kp F9          &kp F10
&trans          &trans          &trans              &trans              &trans                                      &trans          &kp F4          &kp F5          &kp F6          &kp F11
&trans          &trans          &trans              &trans              &trans                                      &trans          &kp F1          &kp F2          &kp F3          &kp F12
&trans          &trans          &trans              &trans              &trans        &trans          &trans        &trans                                                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans          &trans          &trans              &trans              &trans                                      &trans          &trans          &trans          &trans          &trans
&trans          &trans          &trans              &trans              &trans                                      &trans          &trans          &trans          &trans          &trans
&trans          &trans          &trans              &trans              &trans                                      &trans          &trans          &trans          &trans          &trans
&trans          &trans          &trans              &trans              &trans        &trans          &trans        &trans                                                          &trans
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&trans          &kp CAPSLOCK    &kp LS(LG(N4))      &kp LS(LC(LG(N4)))  &trans                                      &trans          &kp HOME        &kp PG_UP       &kp PG_DN       &kp END
&mt LSHIFT ESC  &mt LCTRL TAB   &mt LALT BSPC       &mt LGUI DEL        &trans                                      &trans          &mt RGUI LEFT   &mt RALT UP     &mt RCTRL DOWN  &mt RSHIFT RIGHT
&trans          &kp C_PREV      &kp C_PP            &kp C_NEXT          &trans                                      &trans          &kp RG(LEFT)    &kp RA(LEFT)    &kp RA(RIGHT)   &kp RG(RIGHT)
&trans          &trans          &trans              &trans              &trans        &trans          &trans        &trans                                                          &trans
            >;
        };

        symbol_number_layer {
            label = "SYM_NUM";
            bindings = <
&trans          &kp N7          &kp N8              &kp N9              &kp EQUAL                                   &kp GRAVE       &kp TILDE       &kp LPAR        &kp RPAR        &trans
&mt LSHIFT PLUS &mt LCTRL N4    &mt LALT N5         &mt LGUI N6         &kp ASTRK                                   &kp UNDERSCORE  &mt RGUI MINUS  &mt RALT LBKT   &mt RCTRL RBKT  &mt RSHIFT SEMI
&kp MINUS       &kp N1          &kp N2              &kp N3              &kp FSLH                                    &kp PIPE        &kp BACKSLASH   &kp LBRC        &kp RBRC        &kp COLON
&trans          &trans          &trans              &kp DOT             &kp N0        &trans          &trans        &trans                                                          &trans
            >;
        };
    };
};
